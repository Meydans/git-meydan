# Neon connection strings (injected automatically when Neon is added via the Vercel Marketplace).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@host/dbname?sslmode=require

# Shared secret for the API (and later the MCP endpoint). Generate with: openssl rand -hex 32
API_TOKEN=

# Password for the web UI. Changing it signs out every session.
APP_PASSWORD=

# Optional: public origin for task links (e.g. in calendar events). Defaults to the Vercel production domain.
APP_URL=
