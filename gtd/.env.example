# Neon connection strings (injected automatically when Neon is added via the Vercel Marketplace).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@host/dbname?sslmode=require

# Shared secret for the API (and later the MCP endpoint). Generate with: openssl rand -hex 32
API_TOKEN=

# Web sign-in (Google OAuth). Create an OAuth client (type: Web application) in Google Cloud Console.
# Authorized redirect URI: <APP_URL>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the session cookie and keys MCP OAuth tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Comma-separated emails allowed to sign in. Anyone else is refused.
ALLOWED_EMAILS=

# Public origin of this deployment, no trailing slash (e.g. https://gtd.example.com; locally http://localhost:3000).
# Required for sign-in; also used for task links in calendar events.
APP_URL=
